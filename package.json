{
  "name": "beacon-wars",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:single && playwright test",
    "smoke": "npm run build:single && playwright test --grep @boot",
    "build:server": "tsc --noEmit -p server && vite build --config vite.server.config.ts",
    "server": "npm run build:server && node dist-server/main.js"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  }
}
